# ============================================
# TagMind 环境变量配置
# 复制本文件为 .env 并填入真实值
# ============================================

# ---------- 服务端口 ----------
API_PORT=3000
WEB_PORT=5173

# ---------- MySQL 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tagmind123
DB_NAME=tagmind

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT 认证 ----------
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ---------- AI API 配置 ----------
# 推荐使用智谱 GLM-4-Flash（永久免费，无额度上限）
# 注册地址：https://open.bigmodel.cn
# 注册 → 实名认证 → 控制台创建 API Key

# AI API 地址（智谱）
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# AI API Key（填你自己的）
AI_API_KEY=30682ab58927499bb43854c8da0c965e.cLJlJCRkydlOsec6

# AI 模型名
AI_MODEL=glm-4-flash

